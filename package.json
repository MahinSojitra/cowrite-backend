{
  "name": "cowrite-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Cowrite redesigned backend (API + Collaboration + Workers)",
  "license": "ISC",
  "scripts": {
    "dev:api": "tsx watch backend/apps/api/src/main.ts",
    "dev:collab": "tsx watch backend/apps/collab/src/main.ts",
    "dev:worker": "tsx watch backend/apps/worker/src/main.ts",
    "dev": "npm-run-all --parallel dev:api dev:collab dev:worker",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/backend/apps/api/src/main.js",
    "start:collab": "node dist/backend/apps/collab/src/main.js",
    "start:worker": "node dist/backend/apps/worker/src/main.js",
    "lint": "eslint backend prisma tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@hocuspocus/extension-redis": "4.0.0",
    "@hocuspocus/server": "4.0.0",
    "@nestjs/common": "11.1.21",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.21",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.1.21",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/sdk-node": "0.218.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "10.53.1",
    "argon2": "0.44.0",
    "bullmq": "5.76.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.10.1",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "14.0.0",
    "yjs": "13.6.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.8.0",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsx": "4.22.1",
    "typescript": "6.0.3"
  }
}
